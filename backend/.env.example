# MongoDB: leave empty / "memory://" for zero-setup in-memory (data resets on restart).
# Set a real URI (local or MongoDB Atlas) for persistent storage.
MONGODB_URI=memory://

# Set to 1 to scrape local fixture files instead of the live sites
# (use when ssc.nic.in / rrbcdg.gov.in etc. are unreachable from your network).
MOCK_SCRAPE=1

PORT=5000

# AI extraction provider: "anthropic" (default, recommended) or "groq"
AI_PROVIDER=anthropic
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# --- Alert channels ---
# Telegram (v1 single-chat fallback + per-user). Get token from @BotFather.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# WhatsApp via Twilio (leave blank to disable). From-number = your Twilio WhatsApp sandbox.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=

# Email via SMTP (leave blank to disable). Use an app password for Gmail.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

# --- Source URLs (overridable) ---
SSC_URL=https://ssc.nic.in
RRB_URL=https://www.rrbcdg.gov.in
TNPSC_URL=https://www.tnpsc.gov.in
UPSC_URL=https://upsc.gov.in
IBPS_URL=https://www.ibps.in
SBI_URL=https://sbi.co.in/web/careers
